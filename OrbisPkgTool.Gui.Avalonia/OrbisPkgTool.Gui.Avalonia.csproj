<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform (Linux / Windows / macOS) GUI built on Avalonia.
       Same layout and command set as the Windows Forms GUI; the command
       definitions are shared source so both front ends stay in sync. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OrbisPkgTool.Gui.Avalonia</AssemblyName>
    <RootNamespace>OrbisPkgTool.Gui</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrbisPkgTool.Gui.Avalonia.Smoke" />
  </ItemGroup>

  <!-- Shared, UI-agnostic command definitions from the Windows Forms GUI. -->
  <ItemGroup>
    <Compile Include="..\OrbisPkgTool.Gui\CommandDef.cs" Link="Shared\CommandDef.cs" />
    <Compile Include="..\OrbisPkgTool.Gui\CommandRegistry.cs" Link="Shared\CommandRegistry.cs" />
  </ItemGroup>

  <!-- In-process metadata summary: PkgReader.GetInfo(). The CLI it builds is
       also what the GUI runs for every operation. -->
  <ItemGroup>
    <ProjectReference Include="..\OrbisPkgTool\OrbisPkgTool.csproj" />
  </ItemGroup>

</Project>
